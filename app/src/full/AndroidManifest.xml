<?xml version="1.0" encoding="utf-8"?>
<!--
    Additions of the full version only (installed from an APK). Features here reach the Google Play
    version after the owner has tried them and they pass the Play policy check (see CLAUDE.md).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <!-- ICON_CUSTOMIZATION: find installed icon packs (the intents icon packs declare). -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="com.teslacoilsw.launcher.THEME" />
        </intent>
        <intent>
            <action android:name="app.lawnchair.icons.THEMED_ICON" />
        </intent>
    </queries>
</manifest>
